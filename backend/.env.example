# Copy to .env for local development. Defaults below are safe for local work only.
#
# In production none of this file is used. Non-secrets are plain entries in
# zappa_settings.json, in git; SECRET_KEY and COGNITO_STAFF_CLIENT_SECRET come from SSM
# at settings import (backend/config/ssm.py). A real environment variable always wins
# over SSM, which is what makes this file work locally.

SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://dakkamotors.com,https://www.dakkamotors.com

# ---- DynamoDB ----
# There is no relational database. The table name is fixed by CloudFormation in
# production; locally, point DYNAMODB_ENDPOINT_URL at DynamoDB Local
# (`docker compose up -d dynamodb` from the repo root).
#
# NEVER set the endpoint in production. And note the table name defaults to the
# production one, so a test run with real credentials and no endpoint override would
# reach the live table -- pass DDB_TABLE=dakkamotors_test when running the suite.
# DDB_TABLE=dakkamotors
# DYNAMODB_ENDPOINT_URL=http://localhost:8123

# ---- Cognito ----
# Identity lives here, not in Django. Without COGNITO_POOL_ID the auth endpoints cannot
# work; without COGNITO_DOMAIN the staff pages return 503 rather than pretending to.
# COGNITO_POOL_ID=ap-northeast-1_xxxxxxxxx
# COGNITO_CUSTOMER_CLIENT_ID=
# COGNITO_STAFF_CLIENT_ID=
# COGNITO_STAFF_CLIENT_SECRET=
# COGNITO_DOMAIN=dakkamotors-staff.auth.ap-northeast-1.amazoncognito.com
# Baked into the deploy so a cold start is not coupled to reaching Cognito.
# COGNITO_JWKS_PATH=config/cognito_jwks.json
# Points Cognito at a local stand-in. Tests only; never set in production.
# COGNITO_ENDPOINT_URL=

# ---- Storage ----
# Leave AWS_STORAGE_BUCKET_NAME unset locally to store uploads on disk under mediafiles/.
# AWS_STORAGE_BUCKET_NAME=dakkamotors-backend-media
# AWS_S3_REGION_NAME=ap-northeast-1
# MEDIA_CUSTOM_DOMAIN=dakkamotors.com

# ---- Email ----
# Nothing is sent inline: mail.queue_email writes JSON to the outbox bucket and a second
# Lambda sends it via Brevo. Unset locally and the write is skipped.
# OUTBOX_BUCKET=dakkamotors-outbox
# MAIL_FROM=noreply@dakkamotors.com
# MAIL_FROM_NAME=Dakka Motors
# MAIL_REPLY_TO=
# STAFF_ALERT_EMAIL=
