# Copy to .env for local development. Defaults below are safe for local work only.
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset locally to fall back to SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dakkamotors

# Leave AWS_STORAGE_BUCKET_NAME unset locally to store uploads on disk under mediafiles/.
# AWS_STORAGE_BUCKET_NAME=dakkamotors-backend-media
# AWS_S3_REGION_NAME=ap-northeast-1
# MEDIA_CUSTOM_DOMAIN=dakkamotors.com

# Used once by `manage.py create_admin_user` to seed the production superuser.
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_EMAIL=admin@dakkamotors.com
# DJANGO_ADMIN_PASSWORD=
